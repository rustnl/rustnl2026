---
import HeroLayout from "../layouts/HeroLayout.astro";

import Person from "../components/people/Person.astro";

import Sponsor from "../components/sponsor/sponsor.astro";
import SponsorTier from "../components/sponsor/sponsor-tier.astro";

import TimetableItem from "../components/timetable/timetable-item.astro";
import Timetable from "../components/timetable/timetable-old.astro";

import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import PeopleList from "src/components/people/PeopleList.astro";
import Sponsors from "src/components/sponsor/Sponsors.astro";
import OneColumn from "src/components/OneColumn.astro";
---

<HeroLayout title="Industry Track" slidedeck="industry">
  <Fragment slot="hero">
    <div>
      <h1 class="font-display">Industry Track</h1>
      <h2>May 19 — Utrecht, NL</h2>
    </div>
    <p>
      The <b>must-attend track for decision makers</b> exploring the adoption of Rust
      <br /> in their organisation. <br />
    </p>
    <div class="button-group cutout cutout-button-group">
      <a href="#tickets" class="button button-primary">Tickets</a>
      <a href="#schedule" class="button button-secondary">Schedule</a>
    </div>
  </Fragment>

  <OneColumn>
    <div class="markdown">
      <h2 id="explainer">Industry Track</h2>
      <p>
        Date & time: <strong>Tuesday 19 May, 9:30 - 17:00 CET</strong>.<br />
      </p>
      <p>
        <b>Morning session: Inspiring Talks</b><br /> The 2026 morning program will
        be open to anyone with a valid
        <b>RustWeek ticket</b>. Speakers include Pete LeVasseur from Woven by
        Toyota and Lori Lorusso, Director of Outreach at the Rust Foundation.
      </p>

      <p>
        <b>Afternoon session: Expert Tables and Networking</b><br />This year
        adds Facilitated Networking to the Expert Table Sessions, because
        getting to know your peers who are pursuing the same goals, is at least
        as useful as learning what to do. To attend the Expert Tables and
        Networking in the afternoon, please make sure to buy the <b
          >add-on "Industry Track Expert Tables participation"</b
        > when you register for RustWeek.
      </p>

      <p>Expert Table topics:</p>
      <ul>
        <li>How to plan your Rust migration - by Matthias Endler</li>
        <li>Software life cycle costs - by Martin Kooij</li>
        <li>
          Introducing Rust in a conservative environment - by Julius Gustavsson
        </li>
        <li>Hiring and training - tba</li>
        <li>Safety Critical Rust - tba</li>
        <li>Embedded Rust- tba</li>
      </ul>
    </div>
  </OneColumn>
  <OneColumn>
    <div class="markdown">
      <h2>Schedule</h2>
      <Timetable>
        <TimetableItem time="9.00" title="Registration" />
        <TimetableItem time="9.30" title="Opening" speaker="Hugo van de Pol" />
        <TimetableItem
          time="09.40"
          title="Popping the Hood on Rust in the 2026 Toyota RAV4"
          speaker="Pete LeVasseur - Woven by Toyota"
        />
        <TimetableItem
          time="10.25"
          title="Rustaceans on The Move - The Global Impact of Rust"
          speaker="Lori Lorusso - Rust Foundation"
        />
        <TimetableItem
          time="10.45"
          title="Tales of a transformation journey at Proton"
          speaker="Jeremy Lempereur - Proton AG"
        />
        <TimetableItem time="11.00" title="Break" />
        <TimetableItem
          time="11.40"
          title="Scaling up Rust development at the Dutch Electoral Council"
          speaker="Mark Janssen - Dutch Electoral Council"
        />
        <TimetableItem
          time="12.25"
          title="7M smart meters running Rust"
          speaker="TBA - Stedin / Schuberg Phillis"
        />
        <TimetableItem time="12.45" title="Lunch" />
        <TimetableItem
          time="14.00"
          title="Opening afternoon program (Industry Room)"
          speaker="Hugo van de Pol"
        />
        <TimetableItem
          time="14.15"
          title="Expert Tables & Networking Round 1"
          speaker="Various industry experts"
        />
        <TimetableItem
          time="15.00"
          title="Live Podcast recording"
          speaker="Matthias Endler"
        />
        <TimetableItem time="15.50" title="Break" />
        <TimetableItem
          time="16.20"
          title="Expert Tables & Networking Round 2"
          speaker="Various industry experts"
        />
        <TimetableItem time="17.05" title="Closing" speaker="Hugo van de Pol" />
        <TimetableItem time="17.20" title="Drinks" />
      </Timetable>
    </div>
  </OneColumn>
  <OneColumn>
    <div class="markdown">
      <h2 class="header space-y-6" id="tickets">Tickets</h2>
      <p>
        The morning program of the Industry Track requires a regular RustWeek
        ticket. The track's talks will be open to all vistors of RustWeek to
        attend; priority access will be given to those with the add-on "Industry
        Track Expert Tables participation".
      </p>
      <p>
        To attend the afternoon program (Expert Tables and Networking) choose
        the add-on "Industry Track Expert Tables participation" (<b
          >EUR 99,- ex vat</b
        >) after choosing your regular ticket type.
      </p>

      <ButtonGroup>
        <Button link="https://event.onliveevent.nl/rustweek-2026"
          >Get ticket</Button
        >
      </ButtonGroup>
    </div>
  </OneColumn>

  <PeopleList title="Already confirmed for 2026" lead="">
    <Person
      name="Pete LeVasseur"
      image="pete.jpg"
      title="Staff Software Engineer at Woven by Toyota"
      smalltile
    />
    <Person
      name="Lori Lorusso"
      image="lori.jpeg"
      title="Director of Outreach at Rust Foundation"
      smalltile
    />
    <Person
      name="Jeremy Lempereur"
      image="jeremy.jpeg"
      title="Software engineer at Proton AG"
      smalltile
    />
    <Person
      name="Mark Janssen"
      image="mark.jpg"
      title="Software Architect at the Dutch Electoral Council"
      smalltile
    />
    <Person
      name="Julius Gustavsson"
      image="julius.png"
      title="System Architect at Volvo Cars"
      smalltile
    />
    <Person
      name="Hugo van de Pol"
      image="hugo.jpeg"
      title="Director at Tweede golf and Trifecta Tech Foundation"
      smalltile
    />
    <Person
      name="Matthias Endler"
      image="matthias.jpg"
      title="Founder and Rust Consultant at Corrode"
      smalltile
    />
    <Person
      name="Martin Kooij"
      image="martin.jpg"
      title="Engineering team Embedded Software at ROCSYS"
      smalltile
    />
  </PeopleList>
  <SponsorTier name="Expert partners">
    <SponsorTier>
      <Sponsor
        name="Rocsys"
        tier="expert-partner"
        image="rocsys2025.png"
        link="https://rocsys.com/"
      />
      <Sponsor
        name="Corrode"
        tier="expert-partner"
        image="corrode.svg"
        link="https://corrode.dev/"
      />
    </SponsorTier>
  </SponsorTier>
  <SponsorTier name="Industry partners">
    <SponsorTier>
      <Sponsor
        name="Rust Foundation"
        tier="industry-partner"
        image="rustfoundation.png"
        link="https://foundation.rust-lang.org/"
      />
      <Sponsor
        name="AWS"
        tier="industry-partner"
        image="aws.png"
        link="https://aws.amazon.com/"
      />
    </SponsorTier>
  </SponsorTier>
  <SponsorTier name="Powered by">
    <SponsorTier>
      <Sponsor
        name="Tweede golf"
        tier="industry-partner"
        image="tweede-golf-v2.png"
        link="https://tweedegolf.nl"
      />
      <Sponsor
        name="RustNL"
        tier="industry-partner"
        image="../rustnl-logo-square.svg"
        link="/about"
      />
    </SponsorTier>
  </SponsorTier>
</HeroLayout>

<ButtonGroup>
  <Button link="https://event.onliveevent.nl/rustweek-2026">Get ticket</Button>
</ButtonGroup>

<style lang="scss">
  @use "../styles/variables.scss";

  .main {
    width: min(96rem, 90%);
    margin-left: auto;
    margin-right: auto;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
