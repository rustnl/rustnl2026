---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return talks.map((talk) => ({
    params: { id: talk.id },
    props: { talk },
  }));
}

import CommonLayout from "../../layouts/CommonLayout.astro";
import "../../styles/index.scss";
import Person from "../../components/people/Person.astro";
import Button from "src/components/Button.astro";
import ButtonGroup from "../../components/ButtonGroup.astro";
import Cta from "src/components/Cta.astro";
import Hero from "src/components/Hero.astro";
import OneColumn from "src/components/OneColumn.astro";
import SpeakerList from "../../components/people/PeopleList.astro"

const { talk } = Astro.props;
let { title, level, day, draft } = talk.data;
const people = await getCollection("people");

function comma_separate(iterable: Iterable<string>): string {
  let res = "";
  let last = ""
  let num_added = 0;

  for (const i of iterable) {
    if (last !== "") {
      num_added += 1;
      if (res === "") {
        res = last
      } else {
        res += `, ${last}`
      }
    }
    last = i
  }

  if (num_added === 0) {
    res = last
  } else if (num_added === 1) {
    res += ` and ${last}`
  } else {
    res += `, and ${last}`
  }

  return res
}

const speakers = people.filter((person) => person.data.talk?.id == talk.id);
const speaker_names = comma_separate(speakers.map((speaker) => speaker.data.name));
const ignore = draft ? { "data-pagefind-ignore": "all" } : {};

if (draft) {
  title = "TBA";
}
---

<CommonLayout title={title} withLogo {...ignore}>
    <OneColumn>
        <div class="title">
            <h2 class="font-display">{title}</h2>
            <h3>by {speaker_names}</h3>
        </div>
        {
            level && (
            <div class="talk-level">
                <strong>Audience:</strong> <span class="tag">{level}</span>
            </div>
            )
        }
    </OneColumn>

  <OneColumn>
      {!draft && (
        <div class="markdown" set:html={talk.rendered?.html} />
      )}
  </OneColumn>
  <SpeakerList ty="single-column">
      {
        speakers.map((speaker) => (
          <Person bio={speaker.rendered?.html} {...speaker.data} single />
        ))
      }
  </SpeakerList>
  <Cta title="Get your ticket" color="yellow">
    <ButtonGroup>
      <Button link="https://event.onliveevent.nl/rustweek-2026">
        Tickets
      </Button>
      {
        day && (
          <Button link={`/schedule/${day}/#${talk.id.split("/").pop()}`}>
            Find in timetable
          </Button>
        )
      }
    </ButtonGroup>
  </Cta>
</CommonLayout>

<style>
.title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1em;

    h3 {
        font-weight: normal;
    }
}

  .persons {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .talk-level {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .talk-level .tag {
    background-color: var(--color-yellow-400);
    padding-inline: 0.75rem;
    border-radius: 0.25rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
  }
</style>
