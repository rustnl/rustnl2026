---
import HotelList from "../components/practical-info/hotels/HotelList.astro";
import Hotel from "../components/practical-info/hotels/Hotel.astro";
import CommonLayout from "../layouts/CommonLayout.astro";
import Hero from "../components/Hero.astro";
import OneColumn from "../components/OneColumn.astro";
---

<CommonLayout
  title="Hotels for All-Hands Attendees"
  header="Hotels for All-Hands Attendees"
  withLogo
>
  <Hero title="Hotels for All-Hands Attendees" color="yellow" />

  <OneColumn>
    <div class="markdown">
      <p>
        Below are some hotel recommendations for your stay in Utrecht during RustWeek 2026.
      </p>
      <p>
        The distances listed below are to the <a href="/kinepolis/">conference venue</a>,
        which is very close to where the free shuttle busses to the <a href="/dus/">All Hands venue</a> will depart.
      </p>
      <p>
        We have reserved blocks of rooms at Moxy, Hampton by Hilton, and HolidayInn.
        The links for these hotels below will take you to custom booking page created for RustWeek.
      </p>
      <p>
        The reservations are for Sunday May 17 through Sunday May 24.
        If you plan to arrive before the 17th or depart after the 24th you can
        reach out to the hotel to extend your stay; see the hotel's booking page for contact details.
        There is a minimum of 3 or 4 nights, depending on the hotel.
      </p>
      <p>
        The reservations will expire in batches, starting at February 16th, then March 18th, and finally April 17th.
        So, please book as early as possible if you want to make use of these.
      </p>
      <p>
        At 2L De Blend we don't have a reserved blocks of rooms,
        but we do have a discount code to get a studio at a reasonable price.
      </p>
    </div>
  </OneColumn>

  <HotelList>
    <Hotel
      name="Moxy Utrecht"
      link="https://app.marriott.com/reslink?id=1762352977355&key=GRP&app=resvlink"
      image="moxy.avif"
      distance="3 min train + 10 min walk"
      price_range="€202">
    <p>
      <strong>35 rooms reserved</strong> for All Hands attendees.
    </p>
    </Hotel>
    <Hotel
      name="Hampton by Hilton"
      link="https://www.hilton.com/en/book/reservation/rooms/?ctyhocn=AMSUNHX&arrivalDate=2026-05-17&departureDate=2026-05-24&groupCode=CHHONL&room1NumAdults=1&cid=OM%2CWW%2CHILTONLINK%2CEN%2CDirectLink"
      image="hilton.jpeg"
      distance="10 min walk"
      price_range="€240">
    <p>
      <strong>20 rooms reserved</strong> for All Hands attendees.
    </p>
    <p>
      Inside the Hoog Catharijne shopping mall, next to the Utrecht Centraal train station.
    </p>
    </Hotel>
    <Hotel
      name="Holiday Inn Express"
      link="https://www.ihg.com/redirect?path=rates&brandCode=EX&localeCode=en&regionCode=1&hotelCode=AMSUT&checkInDate=17&checkInMonthYear=042026&checkOutDate=24&checkOutMonthYear=042026&_PMID=99801505&GPC=ONL&cn=no&adjustMonth=false&showApp=true&monthIndex=00"
      image="holiday-inn-express-utrecht.jpg"
      distance="10 min bus + 18 min walk"
      price_range="€123-€145">
    <p>
      <strong>35 rooms reserved</strong> for All Hands attendees.
    </p>
    <p>
      Slightly outside of Utrecht, at the highway.
    </p>
    </Hotel>
    <Hotel
      name="2L De Blend"
      link="https://2ldeblend.nl/"
      image="deblend.jpg"
      distance="10 min bus + 10 min walk"
      price_range="€150 (studio)"
    >
    <p>
      Hotel with studios and suites with a fully equipped kitchen.
      Roughly in the middle of the <a href="/kinepolis/">conference venue</a>
      and the <a href="/dus/">All Hands venue</a>.
    </p>
    <p>
      Apply code <strong>'RustWeek2026'</strong> for a 20% discount on studios.
    </p>
    </Hotel>
    <Hotel
      name="Bunk Utrecht"
      link="https://wearebunk.com/utrecht/nl/"
      image="bunk.jpg"
      distance="15 min walk"
      price_range="€50 (shared) – €150 (private)">
    </Hotel>
    <Hotel
      name="Park Plaza"
      link="https://www.parkplazautrecht.nl/"
      image="park-plaza.jpg"
      distance="10 min walk"
      price_range="€215">
    </Hotel>
    <Hotel
      name="NH Utrecht (Jaarbeursplein)"
      link="https://www.nh-hotels.com/nl/hotel/nh-utrecht"
      image="nh-utrecht.png"
      distance="5 min walk"
      price_range="€240">
    </Hotel>
    <Hotel
      name="Crowne Plaza"
      link="https://www.ihg.com/crowneplaza/hotels/nl/nl/utrecht/utcur/hoteldetail/"
      image="crowne-plaza.jpeg"
      distance="10 min walk"
      price_range="€250">
    <p>
      Inside the Hoog Catharijne shopping mall, next to the Utrecht Centraal train station.
    </p>
    </Hotel>
    <Hotel
      name="Inntel Hotel Utrecht"
      link="https://www.inntelhotelsutrechtcentre.nl/"
      image="inntel.jpg"
      distance="10 min walk"
      price_range="€275">
    </Hotel>
    <Hotel
      name="Van der Valk Utrecht"
      link="https://www.vandervalkhotelutrecht.nl/"
      image="vdv.jpg"
      distance="10 min tram + 10 min walk"
      price_range="€200">
    <p>
      Slightly outside of Utrecht, at the A12 highway; easy to reach by car.
    </p>
    </Hotel>
  </HotelList>

