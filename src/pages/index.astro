---
import HeroLayout from "../layouts/HeroLayout.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Image from "../components/Image.astro";
import Speaker from "src/components/people/Speaker.astro";
import PeopleList from "src/components/people/PeopleList.astro";
import Location from "src/components/Location.astro";
import MainSchedule from "src/components/schedule/MainSchedule.astro";
import Sponsors from "src/components/sponsor/Sponsors.astro";
import SponsorTier from "src/components/sponsor/sponsor-tier.astro";
import Sponsor from "src/components/sponsor/sponsor.astro";
import { useData } from "../components/useData";
import { getCollection } from "astro:content";
import OneColumn from "src/components/OneColumn.astro";
import Cta from "src/components/Cta.astro";

const people = await getCollection("people");
const { greg, taylor, andreea, alice, andrew, aeva } = useData(people);
const speakers = [taylor, greg, andreea, alice, andrew, aeva];
---

<HeroLayout title="RustWeek 2026">
  <Fragment slot="hero">
    <div>
      <h1 class="font-display">RustWeek 2026</h1>
      <h2>May 18-23 — Utrecht, NL</h2>
    </div>
    <p>
      The world's biggest Rust conference includes one day of workshops, two
      days of talks, a hackathon, social activities, and more!
    </p>
    <div class="button-group cutout cutout-button-group">
      <a
        href="https://event.onliveevent.nl/rustweek-2026"
        class="button button-primary">Tickets</a
      >
      <a href="#week-schedule" class="button button-secondary">Week schedule</a>
    </div>
  </Fragment>
  <OneColumn>
    <div class="markdown">
      <h2 id="explainer">RustWeek 2026</h2>
      <p>
        The world's biggest Rust conference returns to beautiful Utrecht,
        welcoming over 900+ community members, professionals and the maintainers
        of Rust.
      </p>
      <p style="margin-block-end: 0;">
        The week includes one day of workshops, two days of talks, a hackathon,
        and social activities. Additionally, we're hosting an unconference, and
        our second Rust Project All Hands!
      </p>
    </div>
  </OneColumn>
  <MainSchedule />
  <PeopleList
    title="Speakers"
    id="speakers"
    lead="Our CfP has now closed. We will announce our full speaker lineup soon!"
  >
    {
      speakers.map((speaker: any) => (
        <Speaker talkId={speaker.talk.id} smalltile {...speaker} />
      ))
    }
  </PeopleList>
  <Image
    src="/images/rustweek2025/celebration.jpg"
    alt="10 year celebration at RustWeek 2025"
  />
  <Location />
  <Sponsors id="sponsors">
    <div slot="header" class="markdown">
      <h2>Our sponsors</h2>
      <p>
        Interested in sponsoring? Download our <a
          target="_blank"
          href="/resources/sponsorship-prospectus-rustweek-2026.pdf"
          >Sponsorship prospectus</a
        > or <a href="mailto:sponsors@rustnl.org">contact us</a>
      </p>
    </div>
    <SponsorTier name="Diamond sponsors">
      <Sponsor
        name="AWS"
        tier="diamond"
        image="aws.png"
        link="https://aws.amazon.com/"
      />
    </SponsorTier>
    <SponsorTier name="Gold sponsors">
      <Sponsor
        name="Jetbrains"
        tier="gold"
        image="jetbrains.png"
        link="https://jetbrains.com/"
      />
      <Sponsor
        name="Zed Industries"
        tier="gold"
        image="zed.svg"
        link="https://zed.com/"
      />
    </SponsorTier>
    <SponsorTier name="Bronze sponsors">
      <Sponsor
        name="TandemDrive"
        tier="bronze"
        image="tandemdrive.png"
        link="https://tandemdrive.com/"
      />
      <Sponsor
        name="GitButler"
        tier="bronze"
        image="gitbutler.png"
        link="https://gitbutler.com/"
      />
      <Sponsor
        name="Polars"
        tier="bronze"
        image="polars.png"
        link="https://pola.rs/"
      />
    </SponsorTier>
    <SponsorTier name="Supporters">
      <Sponsor
        name="RustJobs"
        tier="supporter"
        image="rustjobs.svg"
        link="https://rustjobs.dev/"
      />
      <Sponsor
        name="Technolution"
        tier="supporter"
        image="technolution.png"
        link="https://www.technolution.com/"
      />
    </SponsorTier>
    <SponsorTier name="All-Hands partners">
      <Sponsor
        name="AWS"
        tier="ecosystem"
        image="aws.png"
        link="https://aws.amazon.com/"
      />
    </SponsorTier>
    <SponsorTier name="Unconf partners">
      <Sponsor
        name="Ferrous Systems"
        tier="ecosystem"
        image="ferrous.png"
        link="https://ferrous-systems.com/"
      />
    </SponsorTier>
    <SponsorTier name="Workshop partners">
      <Sponsor
        name="GiGa infosystems"
        tier="workshop-partner"
        image="giga-systems.svg"
        link="https://giga-infosystems.com/"
      />
    </SponsorTier>
    <SponsorTier name="Organizing partners">
      <Sponsor
        name="Tweede golf"
        tier="organizing-partner"
        image="tweede-golf-v2.png"
        link="https://tweedegolf.nl"
      />
      <Sponsor
        name="Hexcat"
        tier="organizing-partner"
        image="hexcat.png"
        link="https://hexcat.nl"
      />
    </SponsorTier>
  </Sponsors>
  <Image src="/images/rustweek2025/flags.jpg" alt="Flags at RustWeek 2025" />
  <Cta
    title="About RustWeek"
    lead="RustWeek is organised by RustNL, a non-profit that strives to promote the Rust programming language and support Rust's maintainers."
  >
    <ButtonGroup>
      <Button link="/about">More About Us</Button>
    </ButtonGroup>
  </Cta>
</HeroLayout>
