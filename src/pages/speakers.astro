---
import Hero from "src/components/Hero.astro";
import PeopleList from "../components/people/PeopleList.astro";
import CommonLayout from "../layouts/CommonLayout.astro";
import { useData } from "../components/useData";
import { getCollection } from "astro:content";
import Speaker from "src/components/people/Speaker.astro";
import OneColumn from "src/components/OneColumn.astro";

const speakers = await getCollection("people");
---

<CommonLayout title="Speakers" withLogo>
  <div>
    <img data-pagefind-meta="image[src]" style="display: none;" />
    <Hero title="Speakers" color="yellow" />
    <!--
    <OneColumn style="center">
      <div class="markdown pb-12">
        <p>
        </p>
      </div>
    </OneColumn>
    -->
    <PeopleList>
      {
        (() => {
          speakers.sort((_a, _b) => Math.random() - Math.random());
          return speakers
        })().filter(i => !i.data.draft).map((speaker: any) => (
          <Speaker talkId={speaker.data.talk.id} tile {...speaker.data} />
        ))
      }
    </PeopleList>
  </div>
</CommonLayout>
