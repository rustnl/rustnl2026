---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const workshops = await getCollection("workshops");
  return workshops.map((workshop) => ({
    params: { id: workshop.id },
    props: { workshop },
  }));
}

import CommonLayout from "../../layouts/CommonLayout.astro";
import "../../styles/index.scss";
import Person from "../../components/people/Person.astro";
import Button from "../../components/Button.astro";
import ButtonGroup from "../../components/ButtonGroup.astro";
import Cta from "../../components/Cta.astro";
import Hero from "../../components/Hero.astro";
import OneColumn from "../../components/OneColumn.astro";

const { workshop } = Astro.props;
const { title, level, published, img } = workshop.data;
const people = await getCollection("trainers");

// og:image tag needs full url, not a relative one
// TODO create dev + production environment variables for base url
const ogImageBaseUrl = "https://2026.rustweek.org/images/workshops/";
// const ogImageBaseUrl = "http://localhost:4321/images/workshops/";

const trainers = people.filter((person) => person.data.workshop?.id === workshop.id);
const trainer_names = trainers.map((trainer) => trainer.data.name).join(", ");
const ignore = !published ? { "data-pagefind-ignore": "all" } : {};
---

<CommonLayout title={title} withLogo {...ignore} ogImage={`${ogImageBaseUrl}${img}`}>
  <Hero
    kicker="Workshop"
    title={title}
    lead={`by ${trainer_names}`}
    color="yellow"
  >
    {
      level && (
        <div class="talk-level">
          <strong>Audience:</strong> <span class="tag">{level}</span>
        </div>
      )
    }
  </Hero>
  <OneColumn>
    <div class="markdown" set:html={workshop.rendered?.html} />
  </OneColumn>
  <div class="grid cols-12 container">
    <div class="col-start-3 col-end-11 persons">
      {
        trainers.map((trainer) => (
          <Person bio={trainer.rendered?.html} {...trainer.data} single />
        ))
      }
    </div>
  </div>
  <Cta title="Get your ticket" color="yellow">
    <p>
      All workshops are held on <b>Monday May 18</b> starting at <b>10:00</b>.
      <!-- See the <strong><a href="/events/workshops">workshop event page</a></strong> for the -->
      <!-- location, time and other details. -->
    </p>
    <p>
      Workshop tickets are available only in combination with a conference ticket. Choose 'Conference Ticket - Individuals' or 'Conference Ticket -
      Employer-paid', then select 'Workshop participation'. Proceed, and in the next steps select the workshop of your preference.
    </p>
    <ButtonGroup>
      <Button link="https://event.onliveevent.nl/rustweek-2026">
        Tickets
      </Button>
    </ButtonGroup>
  </Cta>
</CommonLayout>

<style>
  .persons {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .talk-level {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .talk-level .tag {
    background-color: var(--color-yellow-400);
    padding-inline: 0.75rem;
    border-radius: 0.25rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
  }
</style>
