---
import Button from './Button.astro';
import { secondary } from './timetable/data';

interface Props {
  anchors?: { id: string }[];
}

const { anchors } = Astro.props;
---

<div class="anchors">
  {
    anchors ? (
      anchors?.map((anchor) => <Button ty="primary" link={`#${anchor.id}`}>{anchor.id}</Button>)
    ) : (
      <slot />
    )
  }
</div>

<style is:global lang="scss">
  .anchors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
</style>
