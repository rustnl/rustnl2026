---
interface Props {
  id?: string;
}

const { id = "" } =
  Astro.props;
---

<div class="sponsors space-y-12" id={id}>
    <div class="header">
        <slot name="header" />
    </div>
    <div class="container">
        <slot />
    </div>
</div>

<style lang="scss">
    @use "../../styles/variables.scss";

    .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
</style>
