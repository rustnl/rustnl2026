---
import Markdown from "../Markdown.astro";

const { name, tier, link, image, showName = false } = Astro.props;

let className = "size-md";
switch (tier) {
    case "headline":
    case "diamond":
        className = "size-xxl";
        break;
    case "gold":
        className = "size-xl";
        break;
    case "ecosystem-partner":
    case "silver":
        className = "size-l";    
        break;
    case "bronze":
    case "organizing-partner":
        className = "size-md";
        break;
    case "supporter":
    case "ecosystem-supporter":
        className = "size-s";
        break;
    case "workshop-partner":
    case "industry-partner":
        className = "size-xs";
        break;
    default:
        className = "size-md";
        break;
}
---

{
    image && (
        <a href=`${link}` class={`sponsor ${className}`}>
            <img alt={name} src={`/images/sponsors/${image}`} />
        </a>
    )
}
{
!image && (
    <Markdown>
            <a
                title={name}
                href={link}
                class=className
            >
                {name}
            </a>
    </Markdown>
    )
}

<style lang="scss">
    @use "../../styles/variables.scss";

    a {
        font-size: variables.$font-size-lg;
    }

    .sponsor {
        aspect-ratio: 16 / 9;
        display: flex;
        box-sizing: border-box;
        border-radius: variables.space(1);
        border: 1px solid var(--color-red-000);

        max-width: 20rem;
        width: 100%;
        padding: 1em;
        cursor: pointer;

        img {
            object-fit: scale-down;
            width: 100%;
            height: 100%;
        }

        &.size-xxl {
            max-width: 28rem;
        }

        &.size-xl {
            max-width: 24rem;
        }

        &.size-l {
            max-width: 20rem;
        }

        &.size-md {
            max-width: 18rem;
        }

        &.size-s {
            max-width: 16rem;
        }

        &.size-xs {
            max-width: 12rem;
        }
    }

    div.sponsor-container {
        p {
            padding-top: 0.5rem;
            font-size: variables.$font-size-md;
        }
    }
</style>
