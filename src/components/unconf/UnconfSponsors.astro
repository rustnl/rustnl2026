---
import Sponsor from "../sponsor/sponsor.astro";
import SponsorTier from "../sponsor/sponsor-tier.astro";
import OneColumn from "../OneColumn.astro";
---

<section class="text-center space-y-12" id="sponsors">
    <OneColumn>
        <div class="markdown">
            <h2>Unconf Sponsors</h2>
            <p>
                Interested in sponsoring the unconf?<br />Download our <a
                    target="_blank"
                    href="/resources/sponsorship-prospectus-rustweek-2026.pdf"
                    >Sponsorship prospectus</a
                >, or <a href="mailto:sponsors@rustnl.org">contact us</a>,
            </p>
        </div>
    </OneColumn>
    <SponsorTier name="Room sponsors">
        <Sponsor
            name="Ferrous Systems"
            tier="ecosystem-partner"
            image="ferrous.svg"
            link="https://ferrous-systems.com/"
        />
        <Sponsor
            name="Microsoft"
            tier="ecosystem-partner"
            image="microsoft.svg"
            link="https://www.microsoft.com/"
        />
        <Sponsor
            name="Canva"
            tier="ecosystem-partner"
            image="canva.svg"
            link="https://canva.com/"
        />
        <Sponsor
            name="VectorWare"
            tier="ecosystem-partner"
            image="vectorware.png"
            link="https://vectorware.com/"
        />
    </SponsorTier>
    <SponsorTier name="Unconf supporters">
        <Sponsor
            name="RustNL"
            tier="ecosystem-supporter"
            image="../rustnl-logo-square.svg"
            link="https://rustnl.org/"
        />
        <Sponsor
            name="Infineon"
            tier="ecosystem-supporter"
            image="infineon.png"
            link="https://www.infineon.com/"
        />
    </SponsorTier>
</section>
