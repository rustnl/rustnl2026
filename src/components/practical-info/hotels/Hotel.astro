---
interface Props {
  name: string;
  link: string;
  image: string;
  distance: string;
  price_range: string;
  description: string;
}

const { name, link, image, description, distance, price_range } =
  Astro.props;
---

<div class="hotel">
  <div class="image-container">
    <a class="image" href={link}
      ><img
        src={`/images/hotels/${image}`}
        alt={`Picture of ${name} hotel`}
      /></a
    >
  </div>
  <div class="info">
    <a href={link}><h4 class="font-display">{name}</h4></a>
    <ul>
      <li>{price_range} / night</li>
      <li>{distance}</li>
    </ul>
    <slot />
  </div>
</div>

<style lang="scss">
  .hotel {
    border: 1px solid var(--color-red-100);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .hotel a {
    text-decoration: none;
  }

  .hotel .image-container {
    border-block-end: inherit;
    position: relative;
  }

  .hotel .image {
    aspect-ratio: 1;
    position: relative;
    border-radius: 0 50% 0 50%;
    overflow: clip;
    display: block;
  }

  .hotel .image img {
    position: absolute;
    height: 100%;
    width: 100%;
  }

  .hotel .info {
    font-size: var(--font-size-md);
    padding-inline: 1rem;
    padding-block: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hotel .info h4 {
    font-size: var(--font-size-lg);
  }
</style>
