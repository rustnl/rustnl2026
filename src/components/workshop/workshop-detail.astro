---
import { library } from '@fortawesome/fontawesome-svg-core';
import { faLocationDot, faClock } from '@fortawesome/free-solid-svg-icons';

const {
  title,
  slug,
  abstract,
  description,
  full,
  hasTitle = true,
} = Astro.props;

library.add(faLocationDot, faClock);
---

    <div>
      {hasTitle && <h2 class="font-display" id={slug}>{title}</h2>}
      <!-- <div class="workshop-detail-item">
        <div class="icon"><Fragment set:html={clockIcon.html} /></div>
        <span>{time}</span>
      </div> -->
    </div>
    {!full && <p>{abstract}</p>}
    {full && <div set:html={description} />}

