        title="Opening afternoon program"
        speakers={[{name: "Hugo van de Pol", image: "hugo.jpeg"}]}
        color="red"
        track={3}
        time="14:00"
        duration={15}
        room={quaternary}
        ticket = "Requires an industry track ticket"
    />
    <Item
        title="Expert Tables & Networking Round 1"
        color="red"
        track={3}
        time="14:15"
        duration={45}
        room={quaternary}
        description="Choose a topic and learn from a seasoned Rust expert as well as your industry peers."
        ticket = "Requires an industry track ticket"
        url="/industry"
    />
    <Item
        title="Live podcast recording"
        speakers={[{name: "Matthias Endler", image: "matthias.jpg"}]}
        color="red"
        track={3}
        time="15:00"
        duration={50}
        room={quaternary}
        url="/industry"
    />
    <Divider start="15:50" end="16:20"> Break </Divider>
    <TrackIndicator afterDivider="16:20" track="Main track" color="yellow" />
    <Item
        talk_slug="hazel"
        color="yellow"
        track={1}
        time="16:20"
        duration={35}
        room={main}
