        talk_slug="folkert"
        color="blue"
        track={2}
        time="10:25"
        duration={35}
        room={secondary}
    />
    <TrackIndicator
        afterDivider="9:30"
        track="Industry track"
        color="red"
        first
    />
    <Item
        title="Opening"
        color="red"
        track={3}
        time="9:30"
        duration={10}
        room={tertiary}
        url="/industry"
    />
    <Item
        talk_slug = "pete"
        color="red"
        track={3}
        time="9:40"
        duration={35}
        room={tertiary}
    />
    <Item
        talk_slug="lori"
        color="red"
        track={3}
        time="10:25"
        duration={15}
        room={tertiary}
    />
    <Item
        talk_slug="jeremy"
        color="red"
        track={3}
        time="10:45"
        duration={15}
        room={tertiary}
    />
    <Divider start="11:00" end="11:40"> Break </Divider>
    <TrackIndicator afterDivider="11:40" track="Main track" color="yellow" />
    <Item
        talk_slug="stefan"
        color="yellow"
        track={1}
        time="11:40"
        duration={35}
        room={main}
    />
    <Item
        talk_slug="rose"
        color="yellow"
        track={1}
        time="12:25"
        duration={20}
        room={main}
    />
    <TrackIndicator afterDivider="11:40" track="Compiler track" color="blue" />
    <Item
        talk_slug="boxy"
        color="blue"
        track={2}
        time="11:40"
        duration={35}
        room={secondary}
    />
    <Item
        talk_slug="bastian"
        color="blue"
        track={2}
        time="12:25"
        duration={20}
        room={secondary}
    />
    <TrackIndicator afterDivider="11:40" track="Industry track" color="red" />
    <Item
        talk_slug="mark"
        color="red"
        track={3}
        time="11:40"
        duration={35}
        room={tertiary}
        ticket=""
    />
    <Item
        title = "7M smart meters running Rust "
        color="red"
        track={3}
        time="12:25"
        duration={20}
        room={tertiary}
        url="/industry"
    />
    <Divider start="12:45" end="14:00"> Lunch </Divider>
