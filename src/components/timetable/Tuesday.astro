        color="blue"
        track={2}
        time="16:20"
        duration={35}
        room={secondary}
    />
    <Item
        talk_slug="aissata"
        color="blue"
        track={2}
        time="17:05"
        duration={35}
        room={secondary}
    />
    <TrackIndicator afterDivider="16:20" track="Industry track" color="purple" />
