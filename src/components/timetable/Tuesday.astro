---
import Item from "./Item.astro";
import MultiItem from "./MultiItem.astro";
import Divider from "./Divider.astro";
import Timetable from "./Timetable.astro";
import TrackIndicator from "./TrackIndicator.astro";
import { breaks, main, secondary, tertiary, quaternary } from "./data.ts";
---

<Timetable breaks={breaks["tuesday"]} {...Astro.props}>
    <Divider start="8:30" end="9:30">Doors open & registration</Divider>
    <TrackIndicator
        afterDivider="9:30"
        track="Main track"
        color="yellow"
        first
    />
    <Item
        title="Opening"
        color="yellow"
        track={1}
        time="9:30"
        duration={10}
        room={main}
    />
    <Item
        talk_slug="taylor"
        color="yellow"
        track={1}
        time="9:40"
        duration={35}
        room={main}
    />
    <Item
        talk_slug="waffle"
        color="yellow"
        track={1}
        time="10:25"
        duration={35}
        room={main}
    />
    <TrackIndicator
        afterDivider="9:30"
        track="Compiler track"
        color="blue"
        first
    />
    <Item
        title="Opening"
        color="blue"
        track={2}
        time="9:30"
        duration={10}
        room={secondary}
    />
    <Item
        talk_slug="ides"
        color="blue"
        track={2}
        time="9:40"
        duration={35}
        room={secondary}
    />
