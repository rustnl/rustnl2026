---
import { getEntry } from "astro:content";
import Person from "./Person.astro";

interface Props {
    name?: string;
    image?: string;
    title?: string;
    summary?: string;
    bio?: string; // bio
    talkId?: string;
    url?: string;
    linkedin?: string;
    twitter?: string;
    mastodon?: string;
    github?: string;
    bluesky?: string;
    tile?: boolean;
    smalltile?: boolean;
}

const { talkId = "" } = Astro.props;

let tracks: string[] = [];
let talkTitle: string = "";

if (talkId) {
    const talk = await getEntry("talks", talkId);
    tracks = talk ? talk.data.tracks : [];
    talkTitle = talk ? talk.data.title : "";
}
---

<Person link={`/talks/${talkId}`} tracks={tracks} {...Astro.props}>
    <p class="talk">
        <strong>Talk:</strong> <em>{talkTitle}</em>
    </p>
</Person>

<style>
    .talk {
        font-style: italic;
    }
</style>
