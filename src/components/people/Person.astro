---
import Icon from "../Icon.astro";
import Pronouns from "./Pronouns.astro";

interface Props {
  name?: string;
  image?: string;
  title?: string;
  summary?: string;
  bio?: string; // bio
  link?: string;
  tracks?: Array<string>;
  url?: string;
  linkedin?: string;
  twitter?: string;
  mastodon?: string;
  github?: string;
  bluesky?: string;
  tile?: boolean;
  smalltile?: boolean;
  single?: boolean;
  pronouns?: string | null;
}

const {
  name,
  image,
  bio,
  title,
  summary = "",
  link = "",
  tracks,
  url,
  linkedin,
  twitter,
  mastodon,
  github,
  bluesky,
  pronouns = null,
  tile = false,
  smalltile = false,
  single = false,
} = Astro.props;

let github_link = github
  ? github.includes("github.com")
    ? github
    : `https://github.com/${github}`
  : null;

function convertTrack(i: string): string {
  switch (i) {
    case "deep_dive":
      return "deep dive track";
    case "main":
      return "main track";
    case "project":
      return "project track";
    case "ecosystem":
      return "ecosystem track";
    case "industry":
      return "industry track";
  }

  return i;
}

const empty_path = "/images/people/empty.png";
const imageFile = image ? `/images/people/${image}` : empty_path;
---

<div
  class:list={[
    "person",
    tile ? "tile" : smalltile ? "small-tile" : "detail",
    single ? "single" : null,
  ]}
>
  <div class="image-container">
    {
      link ? (
        <div class="image">
          <a href={link}>
            <img
              src={`${imageFile}`}
              alt={`Picture of ${name}`}
              class={imageFile == empty_path ? "empty" : null}
            />
          </a>
        </div>
      ) : (
        <div class="image">
          <img
            src={`${imageFile}`}
            alt={`Picture of ${name}`}
            class={imageFile == empty_path ? "empty" : null}
          />
        </div>
      )
    }
  </div>
  <div class="info">
    <div>
        <div class="title">
            <h3 class="font-display">{name}</h3>
            {pronouns !== null && (<Pronouns pronouns={pronouns} />)}
        </div>
        {smalltile && summary && <div class="title">{summary}</div>}
        {!summary && title && <div class="title">{title}</div>}
    </div>
    {
      !(tile || smalltile) && (
        <div class="socials">
          {linkedin && (
            <a href={linkedin}>
              <Icon name="linkedin" />
            </a>
          )}
          {twitter && (
            <a href={twitter}>
              <Icon name="x" />
            </a>
          )}
          {mastodon && (
            <a href={mastodon}>
              <Icon name="mastodon" />
            </a>
          )}
          {github_link && (
            <a href={github_link}>
              <Icon name="github" />
            </a>
          )}
          {bluesky && (
            <a href={bluesky}>
              <Icon name="bluesky" />
            </a>
          )}
          {url && (
            <a href={url}>
              <Icon name="website" />
            </a>
          )}
        </div>
      )
    }
    {!(tile || smalltile) && bio && <div class="markdown" set:html={bio} />}
    {!smalltile && <slot />}
    <div class="tags">
      {
        tracks &&
          tracks.map((track) => (
            <span class={`tag ${track}`}>
              <span>{convertTrack(track)}</span>
            </span>
          ))
      }
    </div>
  </div>
</div>

<style lang="scss">
  @use "../../styles/variables.scss";
  @use '../../styles/breakpoint.scss';

  .person {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .person.single {
    display: grid;

    @include breakpoint.wider_than(sm) {
      gap: 2rem;
      grid-template-columns: 1fr 1fr;
    }
  }

  .person.single .image-container {
    border-block-end: 0;
    background-color: var(--color-green-000);
  }

  .socials {
    display: flex;
    align-items: start;
    justify-content: left;
    flex-direction: row;
    gap: 0.5em;

    a {
      width: fit-content;
      height: fit-content;
      display: flex;
      align-items: center;
      font-size: var(--font-size-lg);
    }
  }

  .person .image-container {
    position: relative;
  }

  .person .image {
    background-color: var(--color-blue-100);
    aspect-ratio: 1;
    border-radius: 50% 0 50% 0;
    overflow: clip;
    position: relative;
  }

  .person .image img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person .tags {
    display: flex;
    flex-wrap: wrap;
    gap: variables.space(2);
    margin-block-start: auto !important;
  }


  .person .info .title {
    display: flex;
    direction: row;
    align-items: center;
    gap: 0.5em;
    vertical-align: center;
  }

  .person .info {
    font-size: var(--font-size-md);
    padding-block: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.75rem;
  }

  .person .info button {
    background-color: transparent;
    border: 0;
    font-size: var(--font-size-body);
    font-family: inherit;
    border: 1px solid var(--color-green-000);
    font-weight: 700;
    padding: 0.5rem;
  }

  .person .info .popover {
    position: fixed;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    padding: 1.5rem;
    border: 1px solid var(--color-green-100);
    width: 100%;
    max-width: 64rem;
    font-size: var(--font-size-lg);
  }

  .person .info .popover::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .person h3 {
    font-size: var(--font-size-lg);
  }

  .person .socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .person .socials a {
    line-height: 1;
  }

  .person .tag {
    align-items: center;
    background-color: var(--color-blue-100);
    border-radius: variables.space(1);
    display: flex;
    font-size: variables.$font-size-md;
    line-height: 1;
    min-height: variables.space(8);
    padding-inline: variables.space(3);

    &.project {
      background-color: var(--color-red-100);
    }

    &.industry,
    &.gosim-spotlight {
      background-color: var(--color-yellow-100);
    }
  }

  .person .markdown {
    font-size: variables.$font-size-md;
  }
</style>
