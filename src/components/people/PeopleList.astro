---
interface Props {
    id?: string,
    title?: string,
    lead?: string,
}

const { id, title, lead }: Props = Astro.props;
---

<style lang="scss">
  .header {
    align-items: center;
    display: flex;
    flex-direction: column;
    text-align: center;
    margin-block-end: 1.5rem;
  }

  .people {
    display: grid;
    gap: 4.5rem;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
</style>

<div class="container" id={id}>
  {
    title && (
      <div class="header markdown">
        <h2>{title}</h2>
        {lead && <p set:html={lead}></p>}
      </div>
    )
  }
  <div class="people">
    <slot />
  </div>
</div>
