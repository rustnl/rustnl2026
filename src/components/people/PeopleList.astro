---
interface Props {
    id?: string,
    title?: string,
    lead?: string,
    ty?: "single-column" | "overview"
}

const { id, title, lead, ty = "overview" }: Props = Astro.props;
---

<div class:list={["container", ty]} id={id}>
  {
    title && (
      <div class="header markdown">
        <h2>{title}</h2>
        {lead && <p set:html={lead}></p>}
      </div>
    )
  }
  <div class="people">
    <slot />
  </div>
</div>

<style>
  .header {
    align-items: center;
    display: flex;
    flex-direction: column;
    text-align: center;
    margin-block-end: 1.5rem;
  }

  .people {
    gap: 4.5rem;

    .overview & {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }

    .single-column & {
        display: grid;
        justify-content: center;
        grid-template-columns: min(40em, 100%);
    }
  }
</style>
