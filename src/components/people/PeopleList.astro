---
interface Props {
    id?: string,
    title?: string,
    lead?: string,
    ty?: "single-column" | "overview"
    random?: boolean,
}

const { id, title, lead, random=true, ty = "overview" }: Props = Astro.props;
---

<div class:list={["container", ty]} id={id}>
  {
    title && (
      <div class="header markdown">
        <h2>{title}</h2>
        {lead && <p set:html={lead}></p>}
      </div>
    )
  }
  <div class:list={["people", random?"shuffle":null]}>
    <slot />
  </div>
</div>

<script>
for (const parent of document.getElementsByClassName("shuffle")) {
  const divs = parent.children;
  const frag = document.createDocumentFragment();
  while (divs.length) {
      frag.appendChild(divs[Math.floor(Math.random() * divs.length)]);
  }
  parent.appendChild(frag);
}
</script>

<style>
  .header {
    align-items: center;
    display: flex;
    flex-direction: column;
    text-align: center;
    margin-block-end: 1.5rem;
  }

  .people {
    gap: 4.5rem;

    .overview & {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }

    .single-column & {
        display: grid;
        justify-content: center;
        grid-template-columns: min(40em, 100%);
    }
  }
</style>
