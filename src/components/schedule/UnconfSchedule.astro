---
import Schedule from "./Schedule.astro";
import ScheduleDay from "./ScheduleDay.astro";
import ScheduleSection from "./ScheduleSection.astro";
import ScheduleItem from "./ScheduleItem.astro";
import BottomNote from "./BottomNote.astro";
---

<div>
<Schedule>
    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>
            <ScheduleItem>
                <span slot="header">Pre-registration</span>
                <span slot="time">10:00–14:00</span>
                <Fragment slot="activities">
                    <p>In town already?<br/>Get your badge early!</p>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
        <ScheduleSection>
            <span slot="location">Beatrixgebouw, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Workshops</span>
                <span slot="attendees">&nbsp;</span>
                <span slot="time">10:00–17:00</span>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>
    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Conference day 1</span>
                <span slot="attendees">800 attendees</span>
                <span slot="time">08:30–19:00</span>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>
    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Conference day 2</span>
                <span slot="attendees">800 attendees</span>
                <span slot="time">08:30–19:00</span>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">DUS, Utrecht,&nbsp;NL</span>

            <ScheduleItem align_end>
                <span slot="header">Unconf</span>
                <span slot="time">09:00–18:00</span>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">DUS, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Unconf</span>
                <span slot="time">09:00–18:00</span>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">DUS, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Unconf</span>
                <span slot="time">09:00–18:00</span>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

</Schedule>


<style>
.align-end {
    margin-top: auto !important;
}
em {
    font-style: italic;
}
</style>
