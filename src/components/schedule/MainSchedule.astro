---
import Schedule from "./Schedule.astro";
import ScheduleDay from "./ScheduleDay.astro";
import ScheduleSection from "./ScheduleSection.astro";
import ScheduleItem from "./ScheduleItem.astro";
import OrganizeOwnActivity from "./OrganizeOwnActivity.astro";
import BottomNote from "./BottomNote.astro";
import Button from "../Button.astro";
import ButtonGroup from "../ButtonGroup.astro";
---

<Schedule logo>
    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>
            <ScheduleItem>
                <span slot="header">Pre-registration</span>
                <span slot="attendees">optional</span>
                <span slot="time">12:00–15:00</span>
                <Fragment slot="activities">
                    <!-- <p>In town already?<br/>Get your badge early!</p> -->
                    <!-- <BottomNote>
                        <a href="/events/pre-registration">Details</a>
                    </BottomNote> -->
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
        <ScheduleSection>
            <span slot="location">Beatrixgebouw, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Workshops</span>
                <span slot="attendees">150 attendees</span>
                <span slot="time">09:30–17:00</span>
                <Fragment slot="activities">
                    <p>8 workshops in total</p>
                    <BottomNote>
                        <a href="/workshops">See details</a>
                    </BottomNote>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>
    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Conference day 1</span>
                <span slot="attendees">800 attendees</span>
                <span slot="time">08:30–19:00</span>
                <Fragment slot="activities">
                    <p style="width: 80%;margin-left: auto;margin-right: auto;"><br /><a href="/schedule/tuesday">23 talks / 3 tracks</a></p>
                    <BottomNote>
                        &nbsp; <!-- <a href="/schedule/wednesday">Talk schedule</a> -->
                    </BottomNote>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>
    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Conference day 2</span>
                <span slot="attendees">800 attendees</span>
                <span slot="time">08:30–19:00</span>
                <Fragment slot="activities">
                    <p style="width: 80%;margin-left: auto;margin-right: auto;"><br /><a href="/schedule/wednesday">27 talks / 3 tracks</a></p>
                    <BottomNote>
                        &nbsp; <!-- <a href="/schedule/wednesday">Talk schedule</a> -->
                    </BottomNote>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Kinepolis, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Hackathon</span>
                <span slot="attendees">150 attendees</span>
                <span slot="time">09:00–18:00</span>
                <Fragment slot="activities">
                    <p style="width: 80%;margin-left: auto;margin-right: auto;"><br /><a href="/events/hackathon">See details</a></p>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
        <ScheduleSection>
            <span slot="location">DUS, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Rust All-Hands & Unconference</span>
                <span slot="attendees">250 attendees</span>
                <span slot="time">09:00–18:00</span>
                <Fragment slot="activities">
                    <p>&nbsp;</p>
                    <BottomNote>Invitation only</BottomNote>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Social activities</span>
                <span slot="attendees">in small groups</span>
                <span slot="time">10:00–22:00</span>
                <Fragment slot="activities">
                    <p style="width: 90%;margin-left: auto;margin-right: auto;"><br />
                        <a href="/events/social-activities">All activities</a> / <a href="https://discord.gg/FSwaWZdk6k">Join Discord</a>
                    </p>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
        <ScheduleSection>
            <span slot="location">DUS, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Rust All-Hands & Unconference</span>
                <span slot="attendees">250 attendees</span>
                <span slot="time">09:00–18:00</span>
                <Fragment slot="activities">
                    <p>&nbsp;</p>
                    <BottomNote>Invitation only</BottomNote>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <ScheduleDay>
        <ScheduleSection>
            <span slot="location">Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Social activities</span>
                <span slot="attendees">in small groups</span>
                <span slot="time">10:00–22:00</span>
                <Fragment slot="activities">
                    <p style="width: 90%;margin-left: auto;margin-right: auto;"><br />
                        <a href="/events/social-activities">All activities</a> / <a href="https://discord.gg/FSwaWZdk6k">Join Discord</a>
                    </p>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
        <ScheduleSection>
            <span slot="location">DUS, Utrecht,&nbsp;NL</span>

            <ScheduleItem>
                <span slot="header">Rust All-Hands & Unconference</span>
                <span slot="attendees">250 attendees</span>
                <span slot="time">09:00–18:00</span>
                <Fragment slot="activities">
                    <p>&nbsp;</p>
                    <BottomNote>Invitation only</BottomNote>
                </Fragment>
            </ScheduleItem>
        </ScheduleSection>
    </ScheduleDay>

    <div slot="extra" class="extra">
        <p><a href="https://discord.gg/FSwaWZdk6k" target="_blank" class="button button-primary">Join our Discord</a> to discuss social activities and find others before the event</p>
        <ButtonGroup>
            <Button link="/schedule/tuesday" ty="secondary">Tuesday schedule</Button>
            <Button link="/schedule/wednesday" ty="secondary">Wednesday schedule</Button>
            <Button link="https://event.onliveevent.nl/rustweek-2026">Get your ticket</Button>
        </ButtonGroup>
        <p>Do you have an idea for a social activity? Let us know via <a href="mailto:rustweek@rustnl.org">rustweek@rustnl.org</a>!</p>
    </div>
</Schedule>

<style>
.align-end {
    margin-top: auto !important;
}

.extra {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
}

</style>
