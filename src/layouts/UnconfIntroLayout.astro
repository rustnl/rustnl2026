---
import CommonLayout from "./CommonLayout.astro";
import OneColumn from "../components/OneColumn.astro";
import Button from "../components/Button.astro";
import Divider from "../components/Divider.astro";
import "../styles/index.scss";
import UnconfSponsors from "../components/unconf/UnconfSponsors.astro";
import UnconfLeaders from "../components/unconf/UnconfLeaders.astro";
import Hero from "src/components/Hero.astro";

const { frontmatter } = Astro.props;
const { title } = frontmatter;
---

<CommonLayout title={title} header={title} withLogo>
    <Hero title={title} color="yellow" />
    <OneColumn>
        <div class="markdown">
            <slot />
        </div>
        <div class="py-12">
            <Button link="/unconf-guide">Guide for participants</Button>
        </div>
    </OneColumn>
    <OneColumn >
        <Divider />
    </OneColumn>
    <UnconfSponsors />
    <OneColumn >
        <Divider />
    </OneColumn>
    <UnconfLeaders />
    <OneColumn>
        <div class="py-12">
            <Button link="/unconf-guide">Guide for participants</Button>
        </div>
    </OneColumn>
</CommonLayout>
